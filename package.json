{
  "name": "numori-website",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "The Numori ecosystem website — a showcase for a family of open-source, privacy-first, AI-free apps and services at a fair price.",
  "author": {
    "name": "Erik Bjerke",
    "email": "contact@erikbjerke.com",
    "url": "https://erikbjerke.com"
  },
  "contributors": [
